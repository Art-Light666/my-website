---
import { commentsConfig } from "@/config";

const c = commentsConfig;

const hasGiscus = c.provider === "giscus" && !!c.repo && !!c.repoId && !!c.categoryId;
// 没配 giscus 的两个 ID 时自动退回 utterances（只需装一个 GitHub App，配置最简单）
const hasUtterances = !hasGiscus && !!c.repo;
const enabled = c.enable === true && (hasGiscus || hasUtterances);
---

{
	enabled && (
		<section class="card-base px-6 md:px-9 py-6 mb-4 onload-animation">
			<div class="flex items-center gap-3 mb-5 font-bold text-lg text-black/85 dark:text-white/85">
				<span class="inline-block w-[3px] h-4 rounded-full bg-[var(--primary)]" />
				<span>{hasGiscus ? "评论" : "评论"}</span>
			</div>
			<div
				id="comments-mount"
				class="min-h-[120px]"
				data-provider={hasGiscus ? "giscus" : "utterances"}
				data-repo={c.repo}
				data-repo-id={c.repoId}
				data-category={c.category}
				data-category-id={c.categoryId}
				data-mapping={c.mapping}
				data-lang={c.lang}
				data-reactions={c.reactionsEnabled ? "1" : "0"}
				data-input-position={c.inputPosition}
			/>
		</section>
	)
}
