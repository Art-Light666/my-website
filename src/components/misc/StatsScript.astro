<!--
  访问统计
  ------------------------------------------------------------------
  首选：自建后端 /api/views（Cloudflare Pages Functions + KV）
        数据存在你自己的 Cloudflare 账号里，可以从 0 开始、随时清零。
  兜底：后端不可用（没绑定 KV / 请求失败）时，自动回退到不蒜子，
        保证页面上不会空一块。

  页面标记约定：
    data-bz-container="site_pv"   容器（拿到数据后显示）
    data-bz="site_pv"             数值节点
  可用键：site_pv（总访问次数）/ site_uv（访客数）/ page_pv（本页阅读量）
-->

<script>
	const API = "/api/views";
	const FALLBACK_TIMEOUT = 4000;

	function applyStats(values: Record<string, number | undefined>): void {
		for (const key of ["site_pv", "site_uv", "page_pv"]) {
			const value = values[key];
			if (value === undefined || value === null || Number.isNaN(value)) {
				continue;
			}
			document.querySelectorAll(`[data-bz="${key}"]`).forEach((el) => {
				el.textContent = String(value);
			});
			document.querySelectorAll(`[data-bz-container="${key}"]`).forEach((el) => {
				(el as HTMLElement).style.display = "inline";
			});
		}
	}

	/** 兜底：不蒜子（第三方） */
	function useBusuanzi(): void {
		const callback = `BusuanziCallback_${Math.floor(Math.random() * 1099511627776)}`;
		const w = window as unknown as Record<string, unknown>;

		w[callback] = (data: Record<string, number>) => {
			try {
				applyStats({
					site_pv: data.site_pv,
					site_uv: data.site_uv,
					page_pv: data.page_pv,
				});
			} finally {
				try {
					delete w[callback];
				} catch {
					/* ignore */
				}
			}
		};

		const s = document.createElement("script");
		s.src = `//busuanzi.ibruce.info/busuanzi?jsonpCallback=${callback}`;
		s.setAttribute("referrerpolicy", "no-referrer-when-downgrade");
		s.onload = () => s.remove();
		s.onerror = () => s.remove();
		document.head.appendChild(s);
	}

	async function loadStats(): Promise<void> {
		const controller = new AbortController();
		const timer = setTimeout(() => controller.abort(), FALLBACK_TIMEOUT);

		try {
			const res = await fetch(
				`${API}?path=${encodeURIComponent(location.pathname)}`,
				{ headers: { accept: "application/json" }, signal: controller.signal },
			);
			if (!res.ok) {
				throw new Error(`api ${res.status}`);
			}
			const data = await res.json();
			if (!data || typeof data.siteViews !== "number") {
				throw new Error("bad payload");
			}
			applyStats({
				site_pv: data.siteViews,
				site_uv: data.siteUv,
				page_pv: data.pageViews,
			});
		} catch {
			// 后端没准备好，退回不蒜子，页面不会留空
			useBusuanzi();
		} finally {
			clearTimeout(timer);
		}
	}

	let lastPath: string | null = null;

	function countOnce(): void {
		if (location.pathname === lastPath) {
			return;
		}
		lastPath = location.pathname;
		void loadStats();
	}

	function setup(): void {
		if (!window.swup?.hooks) {
			return;
		}
		window.swup.hooks.on("page:view", countOnce);
	}

	countOnce();

	if (window.swup) {
		setup();
	} else {
		document.addEventListener("swup:enable", setup);
	}
</script>
