<!--
  访问统计
  ------------------------------------------------------------------
  数据全部来自自建后端 /api/views（Cloudflare Pages Functions + KV）。
  不依赖任何第三方统计服务；后端不可用时计数器保持隐藏。

  页面标记约定：
    data-bz-container="site_pv"   容器（拿到数据后显示）
    data-bz="site_pv"             数值节点
  可用键：site_pv（总访问人次）/ site_uv（访客数）/ page_pv（本页阅读量）
-->

<script>
	const API = "/api/views";
	const TIMEOUT = 5000;

	function applyStats(values: Record<string, number | undefined>): void {
		for (const key of ["site_pv", "site_uv", "page_pv"]) {
			const value = values[key];
			if (value === undefined || value === null || Number.isNaN(value)) {
				continue;
			}
			document.querySelectorAll(`[data-bz="${key}"]`).forEach((el) => {
				el.textContent = String(value);
			});
			document.querySelectorAll(`[data-bz-container="${key}"]`).forEach((el) => {
				(el as HTMLElement).style.display = "inline";
			});
		}
	}

	async function loadStats(): Promise<void> {
		const controller = new AbortController();
		const timer = setTimeout(() => controller.abort(), TIMEOUT);

		try {
			const res = await fetch(`${API}?path=${encodeURIComponent(location.pathname)}`, {
				headers: { accept: "application/json" },
				signal: controller.signal,
			});
			if (!res.ok) {
				throw new Error(`api ${res.status}`);
			}
			const data = await res.json();
			if (!data || typeof data.siteViews !== "number") {
				throw new Error("bad payload");
			}
			applyStats({
				site_pv: data.siteViews,
				site_uv: data.siteUv,
				page_pv: data.pageViews,
			});
		} catch {
			// 后端不可用时保持隐藏，不做任何第三方兜底
		} finally {
			clearTimeout(timer);
		}
	}

	let lastPath: string | null = null;

	function countOnce(): void {
		if (location.pathname === lastPath) {
			return;
		}
		lastPath = location.pathname;
		void loadStats();
	}

	function setup(): void {
		if (!window.swup?.hooks) {
			return;
		}
		window.swup.hooks.on("page:view", countOnce);
	}

	countOnce();

	if (window.swup) {
		setup();
	} else {
		document.addEventListener("swup:enable", setup);
	}
</script>
