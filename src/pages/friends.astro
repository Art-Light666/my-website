---
import { Icon } from "astro-icon/components";
import { friendsConfig } from "../config";
import MainGridLayout from "../layouts/MainGridLayout.astro";

const { title, description, links } = friendsConfig;
---

<MainGridLayout title={title} description={description}>
    <div class="flex w-full rounded-[var(--radius-large)] overflow-hidden relative mb-4">
        <div class="card-base z-10 px-6 md:px-9 py-7 relative w-full onload-animation">
            <div class="flex items-center gap-3 mb-1">
                <span class="inline-block w-[3px] h-5 rounded-full bg-[var(--primary)]"></span>
                <h1 class="font-bold text-2xl text-black/90 dark:text-white/90 transition">{title}</h1>
            </div>
            {description && <p class="text-sm text-black/45 dark:text-white/45 mb-6 ml-[15px] transition">{description}</p>}

            <div class:list={["grid gap-3", links.length === 1 ? "grid-cols-1" : "grid-cols-1 md:grid-cols-2"]}>
                {links.map((link) => (
                    <a href={link.url} target="_blank" rel="noopener noreferrer" class="group flex items-center gap-3 p-3 rounded-xl border border-[var(--line-divider)] bg-[var(--btn-regular-bg)] hover:border-[var(--primary)] hover:bg-[var(--btn-plain-bg-hover)] transition active:scale-[0.98]">
                        <div class="h-11 w-11 flex-none rounded-lg overflow-hidden flex items-center justify-center bg-[var(--btn-regular-bg-hover)] text-[var(--primary)] font-bold text-lg">
                            {link.avatar ? <img src={link.avatar} alt={link.name} loading="lazy" class="h-full w-full object-cover" /> : <span>{link.name.slice(0, 1)}</span>}
                        </div>
                        <div class="min-w-0 flex-1">
                            <div class="font-bold text-[0.95rem] text-black/85 dark:text-white/85 truncate group-hover:text-[var(--primary)] transition">{link.name}</div>
                            {link.desc && <div class="text-xs text-black/40 dark:text-white/40 truncate transition">{link.desc}</div>}
                        </div>
                        <Icon name="fa6-solid:arrow-up-right-from-square" class="flex-none text-[0.7rem] text-black/20 dark:text-white/20 group-hover:text-[var(--primary)] transition" />
                    </a>
                ))}
            </div>

            {links.length === 0 && <p class="text-sm text-black/40 dark:text-white/40">还没有添加友站。</p>}
        </div>
    </div>
</MainGridLayout>
